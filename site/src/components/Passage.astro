---
interface Props {
	title: string;
	id: string;
	big?: boolean;
}
const { title, id, big } = Astro.props;
---

<section class="passage" aria-labelledby={id}>
	<h2 id={id} class:list={['sec-title', { big }]}>{title}</h2>
	<slot />
</section>

<style>
	.passage {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 12px;
		padding-block: 48px 36px;
	}
	.passage :global(p) {
		margin: 0;
		max-width: var(--measure);
		text-wrap: pretty;
	}
	.passage :global(p + p) {
		margin-top: 0.6em;
	}
	.passage :global(code) {
		font: 0.9em var(--font-mono);
	}
</style>
