---
// Visible questions plus the same text as FAQPage structured data. Every answer is checked against the app.
const FAQ = [
	{
		q: 'Is Rays free?',
		a: 'Yes. Rays is free and open source under the AGPL-3.0 licence, with no account and no ads.',
	},
	{
		q: 'Does Rays upload my files to sort them?',
		a: "No. Sorting runs on your Mac with Apple's on-device model, so file contents never leave your computer.",
	},
	{
		q: 'Which Macs does Rays run on?',
		a: 'Rays needs macOS 26 or later. Sorting by content and renaming need Apple Intelligence; simple rules, like disk images to Installers and screenshots to Images, work without it.',
	},
	{
		q: 'How is Rays different from other download managers?',
		a: 'Most download managers stop once the file is saved. Rays also moves it into a folder that fits, can rename it from its content, and can be scripted from Terminal with dl or by AI assistants over MCP. Its engine also measures how many connections each download needs, instead of always opening a fixed number.',
	},
	{
		q: 'Is Rays faster than other download managers?',
		a: 'On a line one connection already fills, every tool runs at line speed, Rays included. Rays pulls ahead when a server throttles each connection or drops connections. Every number is on the benchmarks page, with the script to rerun it.',
	},
	{
		q: 'Can Rays organize folders other than Downloads?',
		a: 'Yes. Add any folder, such as Desktop or Documents, and Rays sorts new files there too. Run dl sort to tidy files that were already there.',
	},
	{
		q: 'Can Rays download Hugging Face models?',
		a: 'Yes. Search Hugging Face in Rays, pick the quantization or weights you need, and download it. Rays can then check each file\'s size and SHA-256 checksum offline.',
	},
	{
		q: 'Can Rays download at night or on a schedule?',
		a: 'Yes. Put downloads in a queue and run it once, every day or on chosen days, only on Wi-Fi, while charging or when the Mac is idle. Rays also learns your fastest hours from your downloads and speed tests, and can send a download to that window.',
	},
	{
		q: 'Does Rays download torrents or YouTube videos?',
		a: 'No. Rays downloads files from direct links, so it does not grab video from sites like YouTube, and it does not download torrents.',
	},
	{
		q: 'Does Rays work with my browser?',
		a: 'Yes. The Rays extension for Chrome, Brave, Edge, Firefox and Zen adds Download with Rays to the right-click menu. Get it from the Chrome Web Store or Firefox Add-ons.',
	},
];
const ld = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<section class="faq" aria-labelledby="faq-title">
	<h2 id="faq-title" class="sec-title">Common questions</h2>
	{
		FAQ.map((f) => (
			<div class="item">
				<h3>{f.q}</h3>
				<p>{f.a}</p>
			</div>
		))
	}
</section>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
	.faq {
		display: grid;
		gap: 12px;
		padding-block: 48px 36px;
	}
	.item {
		padding-block: 14px;
		border-top: 1px solid var(--faint);
		max-width: var(--measure);
	}
	h3 {
		margin: 0 0 6px;
		font: 500 1.0625rem / 1.4 var(--font-text);
		color: var(--ink);
	}
	p {
		margin: 0;
		color: var(--muted);
		font-size: var(--t-small);
		line-height: 1.55;
	}
</style>
