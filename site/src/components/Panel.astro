---
// Decorative panel: the Topography landscape (WebGL, src/scripts/topography.ts). Scrolling the page walks forward
// over the land, scrolling up walks back. Lines use the Rays logo colours. The card colour shows until it loads.
---

<div class="panel" aria-hidden="true" data-topography></div>

<script>
	import { mountTopography } from '../scripts/topography';

	// Valleys, slopes, peaks: the Rays icon's coral, orange and gold; deeper in the light theme.
	const PALETTES = {
		dark: ['#f0607a', '#ff8c42', '#ffd24a'],
		light: ['#be3455', '#c2410c', '#b7791f'],
	};
	const el = document.querySelector<HTMLElement>('[data-topography]');
	if (el) {
		const isLight = () => document.documentElement.dataset.theme === 'light';
		const theme = () => ({ palette: PALETTES[isLight() ? 'light' : 'dark'], lightMode: isLight() });
		const view = mountTopography(el, {
			...theme(),
			lineCount: 24,
			glow: 0.7,
			speed: 0.08,
			scrollTravel: 0.004,
			dpr: Math.min(window.devicePixelRatio || 1, 2),
		});
		new MutationObserver(() => view.update(theme())).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});
	}
</script>

<style>
	.panel {
		position: sticky;
		top: 12px;
		height: calc(100svh - 24px);
		margin-top: 12px;
		border-radius: var(--radius);
		overflow: clip;
		background: var(--chip);
		border: 1px solid var(--faint);
	}
	@media (max-width: 899px) {
		.panel {
			position: relative;
			top: 0;
			margin: 0 0 24px;
			height: 30svh;
		}
	}
</style>
