---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import icon from '../assets/icon.png';
import { NAV } from './nav-links';

interface Props {
	current?: 'features';
}
const { current } = Astro.props;
---

<header class="mark">
	<Image src={icon} alt="" width={28} height={28} />
	<span>Rays</span>
	<span class="by">by <a class="slide" href="https://a6n.ai">a6n</a></span>
	<nav class="top" aria-label="Site">
		{NAV.map((l) => <a class="slide" href={l.href} aria-current={current === 'features' && l.href === '/features/' ? 'page' : undefined}>{l.label}</a>)}
	</nav>
	<ThemeToggle />
</header>

<style>
	.mark {
		display: flex;
		align-items: center;
		gap: 10px;
		padding-top: 48px;
		font: 600 1.125rem var(--font-display);
		letter-spacing: -0.01em;
	}
	.top {
		display: flex;
		align-items: center;
		gap: 18px;
		margin-left: auto;
		font: 400 var(--t-small) var(--font-text);
	}
	.mark > :global(.theme) {
		margin-left: 8px;
	}
	.top a,
	.by {
		white-space: nowrap;
	}
	.top a {
		color: var(--muted);
		text-decoration: none;
	}
	.top a:hover,
	.top a[aria-current] {
		color: var(--ink);
	}
	.top a[aria-current]::after {
		transform: scaleX(1);
	}
	.by {
		color: var(--muted);
		font-weight: 400;
	}
	.by a {
		color: inherit;
		text-underline-offset: 3px;
	}
	.by a:hover {
		color: var(--ink);
	}
	.mark > :global(img) {
		view-transition-name: rays-logo;
	}
	.mark :global(img) {
		width: 28px;
		height: 28px;
	}
	@media (max-width: 899px) {
		.mark {
			padding-top: 8px;
		}
	}
	/* Phones: the brand and the theme switch share the first row, the four links get the second, spread edge to edge. */
	@media (max-width: 600px) {
		.mark {
			flex-wrap: wrap;
			row-gap: 0;
		}
		.mark > :global(.theme) {
			margin-left: auto;
			order: 2;
		}
		.top {
			order: 3;
			flex: 0 0 100%;
			justify-content: space-between;
			gap: 0;
			margin-left: 0;
		}
		/* 44px tall touch targets. */
		.top a {
			padding: 12px 4px;
		}
	}
</style>
