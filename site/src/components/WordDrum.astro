---
// What Rays downloads and sorts, opening on the umbrella phrase. Loops; DrumPause next to the heading satisfies
// WCAG 2.2.2. The keyframes in <style> assume 8 phrases and 1.8 s each; change both together.
const PHRASES = ['everything.', 'AI models.', 'datasets.', 'videos.', 'installers.', 'invoices.', 'screenshots.', 'zip files.'];
const STEP = 360 / PHRASES.length;
const HOLD = 1.8; // seconds per phrase
const total = HOLD * PHRASES.length;

---

<span class="drum" aria-hidden="true" data-pagefind-ignore style={`--duration:${total}s;--radius:${(PHRASES.length * 1.2) / (2 * Math.PI)}em`}>
	<span class="stage">
		<span class="ring">
			{PHRASES.map((p, i) => <span class="face" style={`--angle:${-i * STEP}deg`}>{p}</span>)}
		</span>
	</span>
</span>




<style>
	/* 8 phrases, 1.8 s each: hold for 75 % of the slot, then turn 45° to the next face. */
	@keyframes drum-turn {
		0.00%,
		9.38% {
			transform: rotateX(0deg);
		}
		12.50%,
		21.88% {
			transform: rotateX(45deg);
		}
		25.00%,
		34.38% {
			transform: rotateX(90deg);
		}
		37.50%,
		46.88% {
			transform: rotateX(135deg);
		}
		50.00%,
		59.38% {
			transform: rotateX(180deg);
		}
		62.50%,
		71.88% {
			transform: rotateX(225deg);
		}
		75.00%,
		84.38% {
			transform: rotateX(270deg);
		}
		87.50%,
		96.88% {
			transform: rotateX(315deg);
		}
		100% {
			transform: rotateX(360deg);
		}
	}
	.drum {
		position: relative;
		display: inline-block;
		/* A one-line window: only the current word shows, and the next one rolls through it on each turn. */
		height: 1.3em;
		/* Fits the longest phrase ("screenshots."); a wider drum pushes the heading past the 40rem hero column. */
		width: 6.6em;
		perspective: 900px;
		mask-image: linear-gradient(transparent, #000 18%, #000 82%, transparent);
		vertical-align: middle;
	}
	/* Pull the ring back by its radius so the front face sits at depth 0 and keeps the heading's size. */
	.stage {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		transform: translateZ(calc(var(--radius) * -1));
	}
	.ring {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		animation: drum-turn var(--duration) var(--ease-out) 0.6s infinite both;
	}
	.face {
		position: absolute;
		left: 0;
		top: calc(50% - 0.6em);
		height: 1.2em;
		line-height: 1.2;
		white-space: nowrap;
		color: var(--accent);
		backface-visibility: hidden;
		transform: rotateX(var(--angle)) translateZ(var(--radius));
	}
</style>
