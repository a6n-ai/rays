---
import { svg } from './icons';

interface Props {
	items: { title: string; description: string; href: string; icon: string }[];
}
const { items } = Astro.props;
---

<div class="cards not-content">
	{
		items.map((i) => (
			<a class="card" href={i.href}>
				<span class="art">
					<span class="ic" set:html={svg(i.icon, 20)} />
				</span>
				<span class="body">
					<span class="t">{i.title}</span>
					<span class="d">{i.description}</span>
				</span>
			</a>
		))
	}
</div>

<style>
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
		gap: 1rem;
		margin-block: 1.25rem 2.5rem;
	}
	.card {
		display: grid;
		grid-template-rows: 8.5rem auto;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		background: var(--rays-card);
		color: inherit;
		text-decoration: none;
		overflow: hidden;
		transition: border-color 150ms, background-color 150ms, transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.card:hover {
		border-color: var(--sl-color-gray-4);
		background: var(--rays-card-hover);
		transform: translateY(-2px);
	}
	.card:active {
		transform: translateY(0) scale(0.99);
	}
	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
	}
	.art {
		padding: 1.25rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-white);
	}
	.body {
		display: grid;
		gap: 0.35rem;
		padding: 1.1rem 1.25rem 1.35rem;
	}
	.t {
		color: var(--sl-color-white);
		font-weight: 500;
		font-size: 0.95rem;
	}
	.d {
		color: var(--sl-color-gray-3);
		font-size: 0.875rem;
		line-height: 1.5;
	}
</style>
