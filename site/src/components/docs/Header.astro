---
// Linear-style docs header: brand and search over the sidebar, breadcrumb over the page, actions on the right.
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Image } from 'astro:assets';
import icon from '../../assets/icon.png';

const { sidebar, entry } = Astro.locals.starlightRoute;
type Item = { type: string; label: string; isCurrent?: boolean; entries?: Item[] };
const group = (sidebar as Item[]).find((g) => g.type === 'group' && g.entries?.some((e) => e.isCurrent));
const crumbs = (entry.id === 'docs' ? ['Home'] : [group?.label, entry.data.title].filter(Boolean)) as string[];
const DMG = 'https://rays.a6n.ai/download/Rays.dmg?src=docs';
---

<div class="rh">
	<div class="brand">
		<a href="/" class="logo"><Image src={icon} alt="" width={24} height={24} /><span>Rays</span></a>
		<span class="divider" aria-hidden="true"></span>
		<a href="/docs/" class="section">Docs</a>
		<div class="search"><Search /></div>
	</div>
	<nav class="crumbs" aria-label="Breadcrumb">
		{crumbs.map((c, i) => (i < crumbs.length - 1 ? <><span>{c}</span><span class="slash" aria-hidden="true">/</span></> : <span aria-current="page">{c}</span>))}
	</nav>
	<div class="actions">
		<ThemeSelect />
		<button type="button" class="copy" data-copy-page>
			<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
			<span data-copy-label>Copy page</span>
		</button>
		<a class="get" href={DMG}>Download</a>
	</div>
</div>

<script>
	// Copies the page as markdown (served for Accept: text/markdown by functions/[[path]].js).
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-page]')) {
		const label = button.querySelector('[data-copy-label]')!;
		button.addEventListener('click', async () => {
			try {
				const res = await fetch(location.pathname, { headers: { Accept: 'text/markdown' } });
				const type = res.headers.get('content-type') ?? '';
				if (!res.ok || !type.includes('markdown')) throw new Error('no markdown');
				await navigator.clipboard.writeText(await res.text());
				label.textContent = 'Copied';
			} catch {
				label.textContent = 'Copy failed';
			}
			setTimeout(() => (label.textContent = 'Copy page'), 2000);
		});
	}
</script>

<style>
	.rh {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 100%;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
	}
	.logo,
	.section {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--sl-color-white);
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		white-space: nowrap;
	}
	.section {
		font-weight: 500;
	}
	.logo img {
		width: 24px;
		height: 24px;
	}
	.divider {
		width: 1px;
		height: 1.1rem;
		background: var(--sl-color-gray-5);
	}
	.crumbs {
		display: none;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--sl-color-gray-3);
		white-space: nowrap;
		overflow: hidden;
	}
	.crumbs [aria-current] {
		color: var(--sl-color-white);
	}
	.slash {
		color: var(--sl-color-gray-4);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-inline-start: auto;
	}
	.copy {
		display: none;
		align-items: center;
		gap: 0.4rem;
		height: 2rem;
		padding: 0 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: 500 0.8125rem var(--sl-font);
		cursor: pointer;
		transition: color 150ms, border-color 150ms;
	}
	.copy:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
	}
	.get {
		display: inline-flex;
		align-items: center;
		height: 2rem;
		padding: 0 0.9rem;
		border-radius: 999px;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition: opacity 150ms;
	}
	.get:hover {
		opacity: 0.88;
	}
	@media (min-width: 50rem) {
		.rh {
			display: grid;
			grid-template-columns: calc(var(--sl-sidebar-width) - 2 * var(--sl-nav-pad-x)) minmax(0, 1fr) auto;
			gap: calc(2 * var(--sl-nav-pad-x));
		}
		.search {
			margin-inline-start: auto;
		}
		.crumbs,
		.copy {
			display: flex;
		}
	}
	@media (max-width: 49.99rem) {
		.divider,
		.section {
			display: none;
		}
		.actions :global(starlight-theme-select) {
			display: none;
		}
	}
</style>
