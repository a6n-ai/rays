---
// Pause/play for the hero's motion: the word drum and the landscape. It sits in the landscape's corner, outside the <h1>.
---
<button type="button" class="pause" data-pagefind-ignore data-drum-toggle aria-pressed="false" aria-label="Pause animation">
	<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1" /><rect x="9.5" y="2" width="3.5" height="12" rx="1" /></svg>
</button>

<script>
	const ring = document.querySelector<HTMLElement>('.drum .ring');
	const toggles = document.querySelectorAll<HTMLButtonElement>('[data-drum-toggle]');
	let paused = false;
	let visible = true;
	const apply = () => ring && (ring.style.animationPlayState = paused || !visible ? 'paused' : 'running');
	const set = (next: boolean) => {
		paused = next;
		toggles.forEach((toggle) => {
		toggle.setAttribute('aria-pressed', String(paused));
		toggle.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation');
		toggle.innerHTML = paused
			? '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4 2.5v11a1 1 0 0 0 1.5.86l9-5.5a1 1 0 0 0 0-1.72l-9-5.5A1 1 0 0 0 4 2.5Z"/></svg>'
			: '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1" /><rect x="9.5" y="2" width="3.5" height="12" rx="1" /></svg>';
		});
		apply();
		window.dispatchEvent(new CustomEvent('rays:motion', { detail: paused }));
	};
	toggles.forEach((toggle) => toggle.addEventListener('click', () => set(!paused)));
	if (ring) new IntersectionObserver(([e]) => ((visible = e.isIntersecting), apply())).observe(ring.parentElement!);
</script>

<style>
	.pause {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		fill: currentColor;
		cursor: pointer;
		transition: color 160ms var(--ease-out), background-color 160ms var(--ease-out);
	}
	.pause:hover {
		color: var(--ink);
		background: var(--faint);
	}
	@media (max-width: 899px), (pointer: coarse) {
		.pause {
			width: 44px;
			height: 44px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pause {
			display: none;
		}
	}
</style>
