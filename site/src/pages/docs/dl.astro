		margin: 0 0 12px;
		font: 500 var(--t-hero) / 1.2 var(--font-display);
		letter-spacing: -0.02em;
	}
	.lead {
		color: var(--muted);
	}
	h2 {
		margin: 48px 0 12px;
		padding-top: 20px;
		border-top: 1px solid var(--line);
		font: 500 var(--t-label) / 1.4 var(--font-text);
	}
	p {
		margin: 0 0 12px;
	}
	code {
		font: 0.9em var(--font-mono);
	}
	pre {
		margin: 0 0 16px;
		padding: 14px 16px;
		border-radius: 14px;
		background: var(--chip);
		overflow-x: auto;
		tab-size: 12;
	}
	pre code {
		font-size: 0.875rem;
		line-height: 1.6;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--t-small);
	}
